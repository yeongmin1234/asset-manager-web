{
  "name": "asset-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run build:scm-preview && vite build",
    "build:scm-preview": "vite build scm-preview-src --base /scm-preview/ --outDir ../public/scm-preview --emptyOutDir",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:test": "node ../deploy/frontend_smoke_test.mjs",
    "smoke:check-browser": "node ../deploy/frontend_smoke_test.mjs --check-browser"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/react": "^4.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "tsparticles": "^4.3.2",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
