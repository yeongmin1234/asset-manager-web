APP_NAME=Asset Manager
APP_ENV=production
DATABASE_URL=postgresql+psycopg://asset_user:CHANGE_ME@127.0.0.1:5432/asset_manager_prod
CORS_ORIGINS=http://192.168.222.210:3010,http://112.216.230.162:3010,http://thelimo.asuscomm.com:3010,http://localhost:5173,http://localhost:3010
SECRET_KEY=CHANGE_ME
AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AUTH_TOKEN_MINUTES=480
# X-Forwarded-For is trusted only when the direct peer is listed here.
TRUSTED_PROXY_IPS=
HOST=0.0.0.0
PORT=8010
UPLOAD_DIR=../uploads
EXPORT_DIR=../exports

# ECOUNT Open API authentication test (disabled by default)
ECOUNT_ENABLED=false
ECOUNT_COMPANY_CODE=
ECOUNT_USER_ID=
ECOUNT_API_CERT_KEY=
ECOUNT_API_MODE=test
ECOUNT_REQUEST_TIMEOUT=15
ECOUNT_TRUST_SSL=true

# Backend inventory snapshot scheduler (enable only after Alembic upgrade)
INVENTORY_SCHEDULER_ENABLED=false
INVENTORY_SNAPSHOT_MAX_ITEMS=200
INVENTORY_SNAPSHOT_REQUEST_INTERVAL=1.0
INVENTORY_SNAPSHOT_412_MAX_RETRIES=2
INVENTORY_SNAPSHOT_RETENTION_DAYS=180

# Optional natural-language intent interpreter (rules always run first)
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=8
AI_FALLBACK_ENABLED=true
AI_MIN_CONFIDENCE=0.70
