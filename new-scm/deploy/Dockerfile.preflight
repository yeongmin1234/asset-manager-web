FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/new-scm
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY deploy/preflight.py ./deploy/preflight.py
COPY deploy/check_preflight_image.py ./deploy/check_preflight_image.py
COPY backend/app/db/auth_policy.py ./backend/app/db/auth_policy.py
# COPY preserves restrictive source modes (for example NAS files with mode 600).
# Normalize only this image's files and directory traversal permissions.
RUN chown -R 0:0 /srv/new-scm \
    && chown 0:0 /srv \
    && chmod 755 /srv /srv/new-scm /srv/new-scm/deploy /srv/new-scm/backend \
                 /srv/new-scm/backend/app /srv/new-scm/backend/app/db \
    && chmod 644 /srv/new-scm/deploy/preflight.py \
                 /srv/new-scm/deploy/check_preflight_image.py \
                 /srv/new-scm/backend/app/db/auth_policy.py
USER 10001:10001
# Fail the build if the final nonroot user cannot read/import/execute the verifier.
RUN ["python", "-I", "-B", "/srv/new-scm/deploy/check_preflight_image.py"]
ENTRYPOINT ["python", "-I", "-B", "/srv/new-scm/deploy/preflight.py", "--isolated-worker"]
