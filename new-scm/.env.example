SCM_ENV=development
# Use a URL-encoded password. Keep existing .env values; never copy asset DB/JWT keys.
# Required target: postgresql+psycopg://new_scm_ro:<password>@127.0.0.1:15432/new_scm_dev
# Compose preserves credentials and routes this URL through the private Unix socket.
SCM_DATABASE_URL=
SCM_DIAGNOSTICS_KEY=
SCM_CORS_ORIGINS=
SCM_BIND_HOST=127.0.0.1
SCM_HTTP_PORT=8011
VITE_SCM_API_BASE_URL=/api/v1
# Separate least-privilege writer: new_scm_auth, same DB/relay; never use new_scm_ro here.
SCM_AUTH_DATABASE_URL=
# Development: http://127.0.0.1:8011 (SSH tunnel); production: exact dedicated HTTPS origin.
SCM_FRONTEND_ORIGIN=http://127.0.0.1:8011
