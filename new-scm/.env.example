SCM_ENV=development
# Use a URL-encoded password. Keep existing .env values; never copy asset DB/JWT keys.
# Required target: postgresql+psycopg://new_scm_ro:<password>@127.0.0.1:15432/new_scm_dev
# Compose preserves credentials and routes this URL through the private Unix socket.
SCM_DATABASE_URL=
SCM_DIAGNOSTICS_KEY=
SCM_CORS_ORIGINS=
SCM_BIND_HOST=127.0.0.1
SCM_HTTP_PORT=8011
VITE_SCM_API_BASE_URL=/api/v1
SCM_IDENTITY_BASE_URL=http://nas-host:8010
# Dedicated handoff key must match the identity server; never use its JWT secret.
SCM_HANDOFF_KEY=
# Exact browser origins must be confirmed before use. No assumed NAS/public URL.
SCM_HANDOFF_ORIGIN=
SCM_FRONTEND_ORIGIN=
